# Novel Agents 的模型密钥只通过环境变量提供：model.json 保存的是变量名，
# 不是密钥本身。把本文件复制为 .env（已被 .gitignore 忽略）即可本地生效。
# 参考 README 的「API 密钥只走环境变量」一节。

# 通用兜底变量：没有绑定专属变量名的模型会读取它。
NOVEL_API_KEY=replace_me
NOVEL_MODEL=replace_with_model_name
NOVEL_BASE_URL=https://api.openai.com/v1
NOVEL_TEMPERATURE=0.4

# 每个模型也可以使用自己的专属变量，变量名会显示在“模型”页，形如
# NOVEL_API_KEY_<模型 ID 大写>。专属变量优先于上面的通用变量。
# NOVEL_API_KEY_DEFAULT=sk-xxxxxxxxxxxxxxxx
# NOVEL_API_KEY_MODEL_1D5F2E89CD=sk-yyyyyyyyyyyyyyyy
